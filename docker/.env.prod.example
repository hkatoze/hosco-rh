# Copier ce fichier vers .env.prod puis renseigner de vraies valeurs.
# .env.prod n'est jamais versionné (voir .gitignore) : c'est là que vivent
# le mot de passe de la base et l'adresse réelle du serveur.

POSTGRES_USER=hosco
POSTGRES_PASSWORD=change-moi-en-un-mot-de-passe-fort

POSTGRES_DB=hosco_personnel

# IP du serveur sur le réseau local de l'hôpital, telle que tapée dans le
# navigateur du poste RH (http://IP, sans port — Caddy écoute sur :80).
# Doit correspondre EXACTEMENT à ce qui apparaît dans la barre d'adresse
# (le serveur compare l'en-tête Origin envoyé par le navigateur à cette
# valeur, voir verifierOrigine) : même schéma http, même adresse, pas de
# barre oblique finale.
ORIGINE_ATTENDUE=http://192.168.1.10
