DATABASE_URL="postgresql://hosco:hosco@localhost:5432/hosco_personnel?schema=public"

PORT=3000
# false en dev (HTTP), true en production derrière Caddy (HTTPS)
COOKIE_SECURE=false
ORIGINE_ATTENDUE=http://localhost:5173

# Racine de stockage des documents, HORS de la racine web (jamais servie
# statiquement). Par défaut en dev : server/.donnees/documents. En
# production, pointer vers un volume Docker monté hors du conteneur app.
# DOCUMENTS_RACINE=/donnees/documents
